        <mxCell id="2eFuHmcc6IHV6fNcszgk-64" value="JDBC" style="edgeLabel;html=1;align=center;verticalAlign=middle;resizable=0;points=[];" vertex="1" connectable="0" parent="2eFuHmcc6IHV6fNcszgk-63">
